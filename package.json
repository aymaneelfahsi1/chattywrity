{
  "name": "chattywrity",
  "version": "0.6.0",
  "description": "Desktop speech-to-text app using Whisper, activated by Ctrl+Spacebar",
  "main": "dist/main/index.js",
  "scripts": {
    "postcompile": "node scripts/copy-renderer.mjs",
    "dev": "npm run compile && electron .",
    "build": "npm run compile && electron-builder",
    "compile": "tsc"
  },
  "author": {
    "name": "Aymane Elfahsi",
    "email": "aymaneelfahsi1@users.noreply.github.com"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "active-win": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "nodejs-whisper": "^0.1.18",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.chattywrity.app",
    "productName": "ChattyWrity",
    "npmRebuild": false,
    "compression": "store",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "dir"
      ],
      "category": "Utility",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/preload.js",
      "dist/preload.js.map",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      },
      {
        "from": "resources/whisper",
        "to": "whisper"
      }
    ],
    "asarUnpack": []
  }
}
